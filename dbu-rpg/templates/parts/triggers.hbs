<h4 class="dbu-section">{{localize "DBU.Trigger.Title"}} <a data-action="{{addAction}}" data-path="{{path}}"><i class="fa-solid fa-plus"></i></a></h4>
<p class="dbu-hint">{{localize "DBU.Trigger.Hint"}}</p>
<div class="dbu-triggers">
  {{#each rows as |t i|}}
  <div class="dbu-trigger {{#unless t.active}}off{{/unless}}">
    <div class="dbu-trigger-line">
      <input type="checkbox" name="{{../path}}.{{i}}.active" {{checked t.active}} data-tooltip="{{localize 'DBU.Active'}}">
      <input type="text" class="label" name="{{../path}}.{{i}}.label" value="{{t.label}}" placeholder="{{localize 'DBU.Mod.Label'}}">
      <select name="{{../path}}.{{i}}.event" data-tooltip="{{localize 'DBU.Trigger.When'}}">{{selectOptions @root.triggerEvents selected=t.event valueAttr="value" labelAttr="label"}}</select>
      <select name="{{../path}}.{{i}}.effect" data-tooltip="{{localize 'DBU.Trigger.What'}}">{{selectOptions @root.triggerEffects selected=t.effect valueAttr="value" labelAttr="label"}}</select>
      <select name="{{../path}}.{{i}}.mode" data-tooltip="{{localize 'DBU.Trigger.ModeLabel'}}">{{selectOptions @root.triggerModes selected=t.mode valueAttr="value" labelAttr="label"}}</select>
      <a data-action="{{../removeAction}}" data-path="{{../path}}" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a>
    </div>
    <div class="dbu-trigger-line">
      <label>{{localize "DBU.Mod.Value"}} <input type="text" name="{{../path}}.{{i}}.value" value="{{t.value}}" placeholder="3(bT)"></label>
      <label>{{localize "DBU.Trigger.Resource"}} <input type="text" name="{{../path}}.{{i}}.resource" value="{{t.resource}}" placeholder="Battle Born / surging / guardDown / item:Hype Maneuver"></label>
      <label>{{localize "DBU.Mod.Condition"}} <input type="text" name="{{../path}}.{{i}}.condition" value="{{t.condition}}" placeholder="@round % 2 == 0"></label>
      <label>{{localize "DBU.Trigger.DurationLabel"}} <select name="{{../path}}.{{i}}.duration">{{selectOptions @root.triggerDurations selected=t.duration valueAttr="value" labelAttr="label"}}</select></label>
    </div>
    <div class="dbu-trigger-line">
      <label data-tooltip="{{localize 'DBU.Trigger.TargetTip'}}">{{localize "DBU.Trigger.TargetLabel"}} <select name="{{../path}}.{{i}}.target">{{selectOptions @root.triggerTargets selected=t.target valueAttr="value" labelAttr="label"}}</select></label>
      <label data-tooltip="{{localize 'DBU.Trigger.LimitTip'}}">{{localize "DBU.Trigger.LimitLabel"}} <input type="text" name="{{../path}}.{{i}}.limit" value="{{t.limit}}" placeholder="1/Round"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.LimitKeyTip'}}">{{localize "DBU.Trigger.LimitKeyLabel"}} <input type="text" name="{{../path}}.{{i}}.limitKey" value="{{t.limitKey}}" placeholder="burst"></label>
    </div>
    <div class="dbu-trigger-line">
      <label data-tooltip="{{localize 'DBU.Trigger.CostTip'}}">{{localize "DBU.Trigger.CostLabel"}} <input type="text" name="{{../path}}.{{i}}.cost" value="{{t.cost}}" placeholder="ki:2(bT); counters:1"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.AmountTip'}}">{{localize "DBU.Trigger.AmountLabel"}} <input type="text" name="{{../path}}.{{i}}.amount" value="{{t.amount}}" placeholder="@res.battleborn"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.Field.groupTip'}}">{{localize "DBU.Trigger.Field.group"}} <input type="text" name="{{../path}}.{{i}}.group" value="{{t.group}}" placeholder="aw2"></label>
    </div>
    <div class="dbu-trigger-line">
      <label data-tooltip="{{localize 'DBU.Trigger.Field.rollTip'}}">{{localize "DBU.Trigger.Field.roll"}} <input type="text" name="{{../path}}.{{i}}.roll" value="{{t.roll}}" placeholder="1d10"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.Field.rollKeyTip'}}">{{localize "DBU.Trigger.Field.rollKey"}} <input type="text" name="{{../path}}.{{i}}.rollKey" value="{{t.rollKey}}" placeholder="pressure"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.Field.checkTip'}}">{{localize "DBU.Trigger.Field.check"}} <input type="text" name="{{../path}}.{{i}}.check" value="{{t.check}}" placeholder="steadfast:-2 / clash:might"></label>
      <label data-tooltip="{{localize 'DBU.Trigger.Field.onCheckTip'}}">{{localize "DBU.Trigger.Field.onCheck"}} <select name="{{../path}}.{{i}}.onCheck">{{selectOptions @root.triggerOnCheck selected=t.onCheck valueAttr="value" labelAttr="label"}}</select></label>
      <label data-tooltip="{{localize 'DBU.Trigger.Field.withTip'}}">{{localize "DBU.Trigger.Field.with"}} <input type="text" name="{{../path}}.{{i}}.with" value="{{t.with}}" placeholder="surge.healMult=2"></label>
    </div>
  </div>
  {{else}}
  <p class="dbu-empty">{{localize "DBU.Trigger.None"}}</p>
  {{/each}}
</div>
