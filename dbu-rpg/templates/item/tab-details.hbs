<section class="tab {{tab.cssClass}}" data-tab="details" data-group="primary">

{{!-- ================= RACE ================= --}}
{{#if isType.race}}
  <h3 class="dbu-section">{{localize "DBU.Race.Increases"}}</h3>
  <div class="dbu-attr-inputs">
    {{#each attributes as |a|}}
    <label>{{a.abbr}} <input type="number" name="system.increases.{{a.key}}" value="{{lookup ../source.increases a.key}}" min="0" max="4" data-dtype="Number"></label>
    {{/each}}
  </div>
  <p class="dbu-hint">{{localize "DBU.Race.IncreaseHint"}}</p>
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Race.Rule"}} <input type="text" name="system.increaseRule" value="{{source.increaseRule}}"></label>
    <label>{{localize "DBU.Race.Plus2"}} <input type="text" name="system.allowed.plus2" value="{{source.allowed.plus2}}" placeholder="fo;te"></label>
    <label>{{localize "DBU.Race.Plus1"}} <input type="text" name="system.allowed.plus1" value="{{source.allowed.plus1}}" placeholder="ag"></label>
    <label>RLM <input type="number" name="system.rlm" value="{{source.rlm}}" data-dtype="Number"></label>
    <label>{{localize "DBU.Skill.RacialRanks"}} <input type="number" name="system.skillRanks" value="{{source.skillRanks}}" min="0" data-dtype="Number"></label>
    <label class="check"><input type="checkbox" name="system.minion" {{checked source.minion}}> Minion Race</label>
    <label class="check"><input type="checkbox" name="system.unnatural" {{checked source.unnatural}}> Unnatural</label>
  </div>
  <h4>{{localize "DBU.Saves"}}</h4>
  <multi-select name="system.saves">
    {{selectOptions saveOptions selected=source.saves valueAttr="value" labelAttr="label"}}
  </multi-select>
  {{#if source.traits.length}}
  <h4>{{localize "DBU.RacialTraits"}}</h4>
  <ul class="dbu-list">{{#each source.traits as |t|}}<li>{{t}}</li>{{/each}}</ul>
  {{/if}}
{{/if}}

{{!-- ================= RACIAL TRAIT ================= --}}
{{#if isType.racialTrait}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.RaceLabel"}} <input type="text" name="system.race" value="{{source.race}}"></label>
    <label>{{localize "DBU.Category"}}
      <select name="system.category">
        <option value="body" {{#if (eq source.category "body")}}selected{{/if}}>{{localize "DBU.TraitCat.body"}}</option>
        <option value="mind" {{#if (eq source.category "mind")}}selected{{/if}}>{{localize "DBU.TraitCat.mind"}}</option>
      </select>
    </label>
    <label>{{localize "DBU.TraitTier.label"}}
      <select name="system.tier">
        {{#each (object primary="DBU.TraitTier.primary" secondary="DBU.TraitTier.secondary" subrace="DBU.TraitTier.subrace" factor="DBU.TraitTier.factor" benefit="DBU.TraitTier.benefit" drawback="DBU.TraitTier.drawback") as |label key|}}
        <option value="{{key}}" {{#if (eq ../source.tier key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Factor <input type="text" name="system.factor" value="{{source.factor}}"></label>
    <label>{{localize "DBU.Trait.Replaces"}} <input type="text" name="system.replaces" value="{{source.replaces}}"></label>
    <label class="check"><input type="checkbox" name="system.active" {{checked source.active}}> {{localize "DBU.Active"}}</label>
  </div>
{{/if}}

{{!-- ================= TALENT ================= --}}
{{#if isType.talent}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Category"}}
      <select name="system.category">{{selectOptions talentCategories selected=source.category valueAttr="value" labelAttr="label"}}</select>
    </label>
    <label>{{localize "DBU.Talent.TakenAt"}} <input type="number" name="system.takenAt" value="{{source.takenAt}}" min="1" max="30" data-dtype="Number"></label>
    <label class="check"><input type="checkbox" name="system.granted" {{checked source.granted}}> {{localize "DBU.GrantedHint"}}</label>
  </div>
  <label class="wide">{{localize "DBU.PrereqLabel"}} <input type="text" name="system.prerequisites" value="{{source.prerequisites}}"></label>
  {{> "systems/dbu-rpg/templates/item/parts/prereq.hbs"}}
{{/if}}

{{!-- ================= UNIQUE ABILITY ================= --}}
{{#if isType.uniqueAbility}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Type"}} <input type="text" name="system.abilityType" value="{{source.abilityType}}"></label>
    <label>TP <input type="number" name="system.tpCost" value="{{source.tpCost}}" min="0" data-dtype="Number"></label>
    <label>KP <input type="text" name="system.kpCost" value="{{source.kpCost}}" placeholder="2(T)"></label>
    <label>{{localize "DBU.UA.Maneuver"}} <input type="text" name="system.maneuverType" value="{{source.maneuverType}}"></label>
    <label>{{localize "DBU.UA.ActionCost"}} <input type="text" name="system.actionCost" value="{{source.actionCost}}"></label>
    <label class="check"><input type="checkbox" name="system.granted" {{checked source.granted}}> {{localize "DBU.GrantedHint"}}</label>
  </div>
  <p class="dbu-hint">{{localize "DBU.UA.TPSpent" tp=system.tpSpent}}</p>
  <label class="wide">{{localize "DBU.PrereqLabel"}} <input type="text" name="system.prerequisites" value="{{source.prerequisites}}"></label>
  {{> "systems/dbu-rpg/templates/item/parts/prereq.hbs"}}
  <h4>Advancements <a data-action="addRow" data-path="system.advancements"><i class="fa-solid fa-plus"></i></a></h4>
  <table class="dbu-table">
    {{#each source.advancements as |a i|}}
    <tr>
      <td><input type="checkbox" name="system.advancements.{{i}}.owned" {{checked a.owned}} data-tooltip="{{localize 'DBU.UA.Owned'}}"></td>
      <td><input type="text" name="system.advancements.{{i}}.name" value="{{a.name}}"></td>
      <td><input type="number" name="system.advancements.{{i}}.tp" value="{{a.tp}}" min="0" data-dtype="Number"> TP</td>
      <td><input type="text" name="system.advancements.{{i}}.prerequisite" value="{{a.prerequisite}}"></td>
      <td><a data-action="removeRow" data-path="system.advancements" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a></td>
    </tr>
    {{/each}}
  </table>
  <h4>Restrictions <a data-action="addRow" data-path="system.restrictions"><i class="fa-solid fa-plus"></i></a></h4>
  <table class="dbu-table">
    {{#each source.restrictions as |r i|}}
    <tr>
      <td><input type="checkbox" name="system.restrictions.{{i}}.applied" {{checked r.applied}} data-tooltip="{{localize 'DBU.UA.Applied'}}"></td>
      <td><input type="text" name="system.restrictions.{{i}}.name" value="{{r.name}}"></td>
      <td>−<input type="number" name="system.restrictions.{{i}}.tp" value="{{r.tp}}" min="0" data-dtype="Number"> TP</td>
      <td><a data-action="removeRow" data-path="system.restrictions" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a></td>
    </tr>
    {{/each}}
  </table>
{{/if}}

{{!-- ================= MANEUVER ================= --}}
{{#if isType.maneuver}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.UA.Maneuver"}} <input type="text" name="system.maneuverType" value="{{source.maneuverType}}"></label>
    <label>{{localize "DBU.UA.ActionCost"}} <input type="text" name="system.actionCost" value="{{source.actionCost}}"></label>
    <label>KP <input type="text" name="system.kpCost" value="{{source.kpCost}}"></label>
    <label class="check" data-tooltip="{{localize 'DBU.God.ManeuverTip'}}"><input type="checkbox" name="system.god" {{checked source.god}}> God Maneuver</label>
    {{#if source.god}}<label>DKP <input type="text" name="system.dkpCost" value="{{source.dkpCost}}" placeholder="2(bT)"></label>{{/if}}
    <label>{{localize "DBU.Frequency"}} <input type="text" name="system.frequency" value="{{source.frequency}}" placeholder="1/Round"></label>
    <label>{{localize "DBU.Requirement"}} <input type="text" name="system.requirement" value="{{source.requirement}}"></label>
    <label>Minions <input type="text" name="system.minions" value="{{source.minions}}"></label>
  </div>
{{/if}}

{{!-- ================= TRANSFORMATION ================= --}}
{{#if isType.transformation}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Type"}} <select name="system.transType">{{selectOptions transTypeOptions selected=source.transType valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.Trans.Subtype"}} <input type="text" name="system.subtype" value="{{source.subtype}}" placeholder="lesser / greater / super / standard / special / alternate / legendary"></label>
    <label>{{localize "DBU.Trans.Origin"}} <input type="text" name="system.origin" value="{{source.origin}}" placeholder="Body / Mind"></label>
    <label>{{localize "DBU.Trans.Race"}} <input type="text" name="system.race" value="{{source.race}}"></label>
    <label>{{localize "DBU.Trans.Line"}} <input type="text" name="system.line" value="{{source.line}}"></label>
    <label>Stage <input type="number" name="system.stage" value="{{source.stage}}" min="0" data-dtype="Number"></label>
    <label>ToP {{localize "DBU.Requirement"}} <input type="number" name="system.topReq" value="{{source.topReq}}" min="0" max="7" data-dtype="Number"></label>
    <label>Stress Test <input type="number" name="system.stressReq" value="{{source.stressReq}}" min="0" data-dtype="Number"></label>
    {{#if (eq source.transType "awakening")}}
    <label>Stacks <input type="number" name="system.stacks" value="{{source.stacks}}" min="0" data-dtype="Number"></label>
    <label>Max Stacks <input type="number" name="system.maxStacks" value="{{source.maxStacks}}" min="1" data-dtype="Number"></label>
    <label data-tooltip="{{localize 'DBU.Stack.FreeTip'}}">{{localize "DBU.Stack.FreeLabel"}} <input type="number" name="system.freeStacks" value="{{source.freeStacks}}" min="0" data-dtype="Number"></label>
    {{#if source.tempStacks.length}}<label>{{localize "DBU.Stack.TempLabel"}} <span>{{source.tempStacks.length}}</span></label>{{/if}}
    {{#if source.stackTop}}<label data-tooltip="{{localize 'DBU.Stack.TopTip'}}">{{localize "DBU.Stack.TopLabel"}} <input type="text" name="system.stackTop" value="{{source.stackTop}}"></label>{{/if}}
    <label class="check"><input type="checkbox" name="system.temporary" {{checked source.temporary}}> {{localize "DBU.Trans.Temporary"}}</label>
    {{else}}
    <label class="check"><input type="checkbox" name="system.graded" {{checked source.graded}}> Graded</label>
    <label>Grade <input type="number" name="system.grade" value="{{source.grade}}" min="0" data-dtype="Number"></label>
    {{#if source.graded}}<label>{{localize "DBU.Trans.GradeStress"}} <input type="text" name="system.gradeStress" value="{{source.gradeStress}}" placeholder="+2 por Grade"></label>{{/if}}
    <label>Mastery <input type="number" name="system.mastery" value="{{source.mastery}}" min="0" data-dtype="Number"> <small>/ {{system.masteryNeeded}}</small></label>
    <label class="check"><input type="checkbox" name="system.active" {{checked source.active}}> {{localize "DBU.Active"}}</label>
    <label class="check"><input type="checkbox" name="system.transcended" {{checked source.transcended}}> Transcended</label>
    <label class="check"><input type="checkbox" name="system.prelude" {{checked source.prelude}}> Prelude</label>
    <label class="check"><input type="checkbox" name="system.newLevel" {{checked source.newLevel}}> New Level of Power</label>
    <label class="check" data-tooltip="{{localize 'DBU.Trans.NewLevelPendingTip'}}"><input type="checkbox" name="system.newLevelPending" {{checked source.newLevelPending}}> {{localize "DBU.Trans.NewLevelPending"}}</label>
    <label class="check"><input type="checkbox" name="system.viaManeuver" {{checked source.viaManeuver}}> {{localize "DBU.Trans.ViaManeuver"}}</label>
    <label class="check"><input type="checkbox" name="system.ignoreBulky" {{checked source.ignoreBulky}}> {{localize "DBU.Trans.IgnoreBulky"}}</label>
    {{/if}}
    <label>{{localize "DBU.Trans.Initial"}} <input type="text" name="system.initialEnhancement" value="{{source.initialEnhancement}}"></label>
  </div>
  <label class="wide">{{localize "DBU.PrereqLabel"}} <input type="text" name="system.prerequisites" value="{{source.prerequisites}}"></label>

  {{#unless (eq source.transType "awakening")}}
  <h4>{{localize "DBU.TokenImg.Section"}} <small>{{localize "DBU.TokenImg.Hint"}}</small></h4>
  <div class="dbu-form-grid">
    <label class="wide">{{localize "DBU.TokenImg.Label"}} <file-picker name="system.tokenImg" type="imagevideo" value="{{source.tokenImg}}"></file-picker></label>
  </div>
  {{/unless}}

  <h4>{{localize "DBU.Aura.Title"}} <small>{{auraHint}}</small></h4>
  <div class="dbu-form-grid dbu-aura-fields">
    <label>{{localize "DBU.Aura.StyleLabel"}} <select name="system.aura.style">{{selectOptions auraOptions selected=source.aura.style valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.Aura.Color"}} <color-picker name="system.aura.color" value="{{source.aura.color}}"></color-picker></label>
    <label>{{localize "DBU.Aura.Color2"}} <color-picker name="system.aura.color2" value="{{source.aura.color2}}"></color-picker></label>
  </div>

  {{#if choiceRows.length}}
  <h4>{{localize "DBU.Choice.Section"}}
    {{#if canChoose}}<a data-action="chooseOptions" data-tooltip="{{localize 'DBU.Choice.Open'}}"><i class="fa-solid fa-list-check"></i></a>{{/if}}
  </h4>
  <ul class="dbu-list">
    {{#each choiceRows as |c|}}
    <li><strong>{{c.trait}}</strong>: {{#if c.text}}{{c.text}}{{else}}<em class="dbu-warn">{{localize "DBU.Choice.NotChosen"}}</em>{{/if}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if masteryRows.length}}
  <h4>{{localize "DBU.Mastery.Section"}} <small>{{localize "DBU.Mastery.SectionHint"}}</small></h4>
  <ul class="dbu-list">
    {{#each masteryRows as |m|}}
    <li class="{{#if m.reached}}ok{{/if}}">{{localize "DBU.Mastery.Level" n=m.level}}: {{m.text}}{{#if m.reached}} ✓{{/if}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if gradeRows.length}}
  <h4>{{localize "DBU.Grade.Section"}} <small>{{localize "DBU.Grade.SectionHint"}}</small></h4>
  <ul class="dbu-list">
    {{#each gradeRows as |g|}}
    <li class="{{#if g.reached}}ok{{/if}}">Grade {{g.grade}}: {{g.text}}{{#if g.reached}} ✓{{/if}}</li>
    {{/each}}
  </ul>
  {{/if}}

  <h4>{{localize "DBU.Trans.Bonuses"}} <small>{{localize "DBU.Trans.BonusHint"}}</small></h4>
  <div class="dbu-attr-inputs">
    {{#each attributes as |a|}}
    <label>{{a.abbr}} <input type="text" name="system.bonuses.{{a.key}}" value="{{lookup ../source.bonuses a.key}}" placeholder="1(T)"></label>
    {{/each}}
  </div>

  <h4>{{localize "DBU.Trans.Aspects"}} <a data-action="addRow" data-path="system.aspects"><i class="fa-solid fa-plus"></i></a></h4>
  <table class="dbu-table">
    <thead><tr><th>{{localize "DBU.Trans.Aspect"}}</th><th>{{localize "DBU.Trans.AspectName"}}</th><th>LV</th><th>{{localize "DBU.Trans.Param"}}</th><th></th></tr></thead>
    {{#each source.aspects as |a i|}}
    <tr>
      <td><select name="system.aspects.{{i}}.key">{{selectOptions @root.aspectOptions selected=a.key valueAttr="value" labelAttr="label"}}</select></td>
      <td><input type="text" name="system.aspects.{{i}}.name" value="{{a.name}}"></td>
      <td><input type="number" name="system.aspects.{{i}}.level" value="{{a.level}}" min="0" data-dtype="Number"></td>
      <td><input type="text" name="system.aspects.{{i}}.param" value="{{a.param}}" placeholder="Impulsive/Corporeal"></td>
      <td><a data-action="removeRow" data-path="system.aspects" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a></td>
    </tr>
    {{/each}}
  </table>
  {{#if source.traits.length}}
  <h4>{{localize "DBU.Trans.Traits"}}</h4>
  <ul class="dbu-list">{{#each source.traits as |t|}}<li>{{t}}</li>{{/each}}</ul>
  {{/if}}
  {{#if source.inherited.length}}
  <h4>{{localize "DBU.Traits.Inherited"}} <small>{{localize "DBU.Traits.InheritedHint"}}</small></h4>
  <ul class="dbu-list">{{#each source.inherited as |t|}}<li>{{t.trait}} <small>({{localize "DBU.Traits.From" name=t.from}})</small></li>{{/each}}</ul>
  {{/if}}
{{/if}}

{{!-- ================= SIGNATURE ================= --}}
{{#if isType.signature}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Sig.LevelLabel"}} <select name="system.level">{{selectOptions sig.levelOptions selected=source.level valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.Attack.Profile"}} <select name="system.profile">{{selectOptions profileOptions selected=source.profile valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.Attack.Foundation"}} <select name="system.foundation">{{selectOptions foundationOptions selected=source.foundation valueAttr="value" labelAttr="label"}}</select></label>
    <label>Super Profile <select name="system.superProfile">{{selectOptions superProfileOptions selected=source.superProfile valueAttr="value" labelAttr="label"}}</select></label>
    {{#if (eq source.superProfile "multiProfile")}}
    <label>Multi-Profile <select name="system.multiProfile"><option value="">—</option>{{selectOptions profileOptions selected=source.multiProfile valueAttr="value" labelAttr="label"}}</select></label>
    {{/if}}
    <label class="check"><input type="checkbox" name="system.free" {{checked source.free}}> {{localize "DBU.Sig.FreeHint"}}</label>
    <label class="check"><input type="checkbox" name="system.granted" {{checked source.granted}}> {{localize "DBU.Sig.GrantedHint"}}</label>
    <label>{{localize "DBU.Sig.TPAdjust"}} <input type="number" name="system.tpAdjust" value="{{source.tpAdjust}}" data-dtype="Number"></label>
  </div>

  <div class="dbu-sig-summary">
    <div><span>TP</span><strong>{{sig.comp.tp}}</strong><small>{{sig.comp.tpStart}} + {{sig.comp.tpAdvantages}} − {{sig.comp.tpDisadvantages}}{{#if sig.comp.ultimate}} + 4{{/if}}{{#if (lt sig.comp.tpRaw 8)}} → mín. 8{{/if}}</small></div>
    <div><span>KP</span><strong>{{sig.comp.kpUnits}}{{#if sig.comp.kpAdjust}} {{#if (gt sig.comp.kpAdjust 0)}}+{{/if}}{{sig.comp.kpAdjust}}{{/if}}(T)</strong><small>{{#if sig.kpNow}}= {{sig.kpNow}} KP{{/if}} · mín. {{sig.comp.kpMinUnits}}(T)</small></div>
    <div><span>{{localize "DBU.DamageCat.label"}}</span><strong>{{localize (concat "DBU.DamageCatN." sig.comp.damageCategory)}}</strong><small>AoE: {{#if sig.comp.aoe}}{{sig.comp.aoe}}{{else}}—{{/if}}</small></div>
    <div><span>{{localize "DBU.Sig.Charges"}}</span><strong>max {{sig.comp.maxCharges}}</strong><small>+{{sig.comp.chargeCategory}} {{localize "DBU.Sig.ChargeCat"}}</small></div>
    {{#if sig.cap}}<div><span>{{localize "DBU.Prog.SigCap"}}</span><strong>{{sig.cap}}</strong></div>{{/if}}
  </div>
  {{#if sig.comp.errors.length}}
  <ul class="dbu-validation">{{#each sig.comp.errors as |e|}}<li class="error"><i class="fa-solid fa-circle-xmark"></i> {{e}}</li>{{/each}}</ul>
  {{/if}}
  {{#if sig.comp.warnings.length}}
  <ul class="dbu-validation">{{#each sig.comp.warnings as |e|}}<li class="warning"><i class="fa-solid fa-triangle-exclamation"></i> {{e}}</li>{{/each}}</ul>
  {{/if}}

  {{#*inline "sigRows"}}
  <h4>{{title}} <a data-action="addRow" data-path="{{path}}"><i class="fa-solid fa-plus"></i></a></h4>
  <table class="dbu-table dbu-sig-table">
    <thead><tr><th>{{localize "DBU.Name"}}</th><th>Rank</th><th>TP</th><th>{{localize "DBU.Sig.Choice"}}</th><th></th></tr></thead>
    {{#each rows as |r|}}
    <tr>
      <td>
        <select name="{{../path}}.{{r.index}}.key">{{selectOptions ../options selected=r.key valueAttr="value" labelAttr="label"}}</select>
        {{#if r.summary}}<div class="dbu-small">{{r.summary}}</div>{{/if}}
        {{#if r.requirement}}{{#if (ne r.requirement "N/A")}}<div class="dbu-small dim">{{localize "DBU.Requirement"}}: {{r.requirement}}</div>{{/if}}{{/if}}
      </td>
      <td><input type="number" name="{{../path}}.{{r.index}}.rank" value="{{r.rank}}" min="1" max="{{r.maxRank}}" data-dtype="Number"> <small>/ {{r.maxRank}}</small></td>
      <td class="center">{{r.cost}}</td>
      <td><input type="text" name="{{../path}}.{{r.index}}.choice" value="{{r.choice}}" placeholder="strike / wound / sphere..."></td>
      <td><a data-action="removeRow" data-path="{{../path}}" data-index="{{r.index}}"><i class="fa-solid fa-trash"></i></a></td>
    </tr>
    {{/each}}
  </table>
  {{/inline}}
  {{> sigRows title=(localize "DBU.Sig.Advantages") path="system.advantages" rows=sig.advantages options=sig.advantageGroups}}
  {{> sigRows title=(localize "DBU.Sig.Disadvantages") path="system.disadvantages" rows=sig.disadvantages options=sig.disadvantageGroups}}
{{/if}}

{{!-- ================= WEAPON ================= --}}
{{#if isType.weapon}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Type"}} <select name="system.weaponType">{{selectOptions foundationOptions selected=source.weaponType valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.WeaponSize.label"}} <select name="system.size">{{selectOptions weaponSizeOptions selected=source.size valueAttr="value" labelAttr="label"}}</select></label>
    <label>{{localize "DBU.Category"}} <select name="system.category">{{selectOptions weaponCategoryOptions selected=source.category valueAttr="value" labelAttr="label"}}</select></label>
    <label>Craftsmanship <input type="number" name="system.craftsmanship" value="{{source.craftsmanship}}" min="1" max="5" data-dtype="Number"></label>
    <label>LP <input type="number" name="system.life.value" value="{{source.life.value}}" min="0" data-dtype="Number"> <small>/ {{weaponInfo.life}}</small></label>
    <label>{{localize "DBU.Gear.FavoredElement"}} <input type="text" name="system.favoredElement" value="{{source.favoredElement}}" placeholder="Fire"></label>
    <label class="check"><input type="checkbox" name="system.equipped" {{checked source.equipped}}> {{localize "DBU.Gear.Wielded"}}</label>
    <label class="check"><input type="checkbox" name="system.integrated" {{checked source.integrated}}> Integrated</label>
    <label class="check"><input type="checkbox" name="system.broken" {{checked source.broken}}> {{localize "DBU.Gear.Broken"}}</label>
  </div>
  <p class="dbu-hint">{{localize "DBU.Gear.WeaponHint" slots=weaponInfo.slots dc=weaponInfo.dc dr=weaponInfo.dr}}</p>
  {{> "systems/dbu-rpg/templates/item/parts/qualities.hbs"}}
{{/if}}

{{!-- ================= APPAREL ================= --}}
{{#if isType.apparel}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Category"}} <select name="system.category">{{selectOptions apparelOptions selected=source.category valueAttr="value" labelAttr="label"}}</select></label>
    <label>Craftsmanship <input type="number" name="system.craftsmanship" value="{{source.craftsmanship}}" min="1" max="5" data-dtype="Number"></label>
    <label>{{localize "DBU.Gear.LayerLabel"}}
      <select name="system.layer">
        <option value="top" {{#if (eq source.layer "top")}}selected{{/if}}>{{localize "DBU.Gear.Layer.top"}}</option>
        <option value="middle" {{#if (eq source.layer "middle")}}selected{{/if}}>{{localize "DBU.Gear.Layer.middle"}}</option>
        <option value="bottom" {{#if (eq source.layer "bottom")}}selected{{/if}}>{{localize "DBU.Gear.Layer.bottom"}}</option>
      </select>
    </label>
    <label>{{localize "DBU.Size.label"}} <select name="system.size">{{selectOptions sizeOptions selected=source.size valueAttr="value" labelAttr="label"}}</select></label>
    <label>Break Value <input type="number" name="system.breakValue" value="{{source.breakValue}}" min="0" max="3" data-dtype="Number"></label>
    <label class="check"><input type="checkbox" name="system.equipped" {{checked source.equipped}}> {{localize "DBU.Gear.Worn"}}</label>
    <label class="check"><input type="checkbox" name="system.integrated" {{checked source.integrated}}> Integrated</label>
    <label class="check"><input type="checkbox" name="system.natural" {{checked source.natural}}> Natural Armor</label>
  </div>
  <p class="dbu-hint">{{localize "DBU.Gear.ApparelItemHint" bonus=apparelInfo.bonus grade=apparelInfo.grade slots=apparelInfo.slots dc=apparelInfo.dc}}</p>
  {{> "systems/dbu-rpg/templates/item/parts/qualities.hbs"}}
{{/if}}

{{!-- ================= ITEM ================= --}}
{{#if isType.item}}
  <div class="dbu-form-grid">
    <label>{{localize "DBU.Type"}}
      <select name="system.itemType">
        <option value="basic" {{#if (eq source.itemType "basic")}}selected{{/if}}>{{localize "DBU.Gear.ItemType.basic"}}</option>
        <option value="accessory" {{#if (eq source.itemType "accessory")}}selected{{/if}}>{{localize "DBU.Gear.ItemType.accessory"}}</option>
      </select>
    </label>
    <label>{{localize "DBU.Gear.Quantity"}} <input type="number" name="system.quantity" value="{{source.quantity}}" min="0" data-dtype="Number"></label>
    <label>Craft DC <input type="text" name="system.craftDC" value="{{source.craftDC}}"></label>
    <label>Details <input type="text" name="system.details" value="{{source.details}}"></label>
    <label class="check"><input type="checkbox" name="system.equipped" {{checked source.equipped}}> {{localize "DBU.Gear.Equipped"}}</label>
  </div>
{{/if}}
</section>
