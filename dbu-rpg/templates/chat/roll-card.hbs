<div class="dbu-card dbu-roll kind-{{kind}}">
  <header class="dbu-card-header">
    {{#if img}}<img src="{{img}}" alt="" width="36" height="36">{{/if}}
    <div>
      <h3>{{title}}</h3>
      {{#if subtitle}}<div class="dbu-card-sub">{{subtitle}}</div>{{/if}}
    </div>
  </header>
  <div class="dbu-card-total {{#if crit}}crit{{/if}} {{#if botch}}botch{{/if}} {{#if (eq success true)}}success{{/if}} {{#if (eq success false)}}failure{{/if}}">
    <span class="total">{{total}}</span>
    {{#if crit}}<span class="flag crit">{{localize "DBU.Roll.Critical"}}</span>{{/if}}
    {{#if botch}}<span class="flag botch">{{localize "DBU.Roll.Botch"}}</span>{{/if}}
    {{#if (ne target undefined)}}<span class="flag tn">TN {{target}} — {{#if success}}{{localize "DBU.Roll.Success"}}{{else}}{{localize "DBU.Roll.Failure"}}{{/if}}</span>{{/if}}
  </div>
  <ul class="dbu-breakdown">
    <li><span>{{localize "DBU.Roll.Natural"}}</span><strong>{{natural}}{{#if naturalChanged}} <small>({{rawNatural}})</small>{{/if}}</strong></li>
    {{#each extra as |e|}}<li><span>{{e.label}} <small>{{e.formula}}</small></span><strong>+{{e.total}}</strong></li>{{/each}}
    {{#each parts as |p|}}<li><span>{{p.label}}</span><strong>{{p.value}}</strong></li>{{/each}}
    {{#if crit}}{{#if critTotal}}<li class="crit"><span>{{localize "DBU.Roll.CritDice"}} <small>{{critFormula}}</small></span><strong>+{{critTotal}}</strong></li>{{/if}}{{/if}}
    {{#if botch}}{{#if botchPenalty}}<li class="botch"><span>Botch</span><strong>−{{botchPenalty}}</strong></li>{{/if}}{{/if}}
    {{#if twin}}<li><span>{{#if (eq twin.mode "high")}}Twin-Linked{{else}}Dead-Link{{/if}}</span><strong>{{twin.totals.[0]}} / {{twin.totals.[1]}}</strong></li>{{/if}}
  </ul>
  <div class="dbu-card-foot">Crit {{critTarget}}+ · Botch ≤{{botchRange}}</div>
  {{#each notes as |n|}}<p class="dbu-card-note">{{n}}</p>{{/each}}
  {{{extraHTML}}}
  {{#if buttons.length}}
  <div class="dbu-card-buttons">
    {{#each buttons as |b|}}<button type="button" data-dbu-action="{{b.action}}" {{#if b.actorUuid}}data-actor-uuid="{{b.actorUuid}}"{{/if}}><i class="{{b.icon}}"></i> {{b.label}}</button>{{/each}}
  </div>
  {{/if}}
</div>
